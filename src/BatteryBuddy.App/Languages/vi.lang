# DeviceBuddy
tab.devicebuddy=DeviceBuddy
devicebuddy.heading=Trợ giúp gỡ lỗi phỏng đoán tốt nhất
devicebuddy.intro=Thiết bị có thể được báo là không có pin, dù bạn biết rõ nó {0} có pin.\nCó nhiều nguyên nhân: kiểu kết nối (Bluetooth, bộ thu USB hoặc cáp) và cả trình điều khiển thiết bị đều có thể ảnh hưởng.
devicebuddy.intro.emphasis=thực sự
devicebuddy.purpose=Đối với các thiết bị không được BatteryBuddy tự động nhận dạng, bảng dưới đây nhằm cung cấp các gợi ý (một phỏng đoán tốt nhất) về lý do bạn không thấy thiết bị, và những gì bạn có thể thử để nó hoạt động.
devicebuddy.report=Nếu bạn nghi ngờ (hoặc biết!) đây là lỗi trong BatteryBuddy, vui lòng sử dụng nút "{0}" ở cuối ứng dụng để cho tôi biết.
devicebuddy.connection=Kết nối do Windows báo cáo
devicebuddy.battery=Thông tin pin
devicebuddy.hint=Giải thích / những gì cần thử
devicebuddy.scanning=Đang quét các thiết bị và kiểm tra các nguồn pin...
devicebuddy.failed=Một số nguồn không thể đọc được: {0}. Danh sách này có thể không đầy đủ, hoặc thông tin pin có thể bị thiếu vì một nguồn đã thất bại. Hãy thử Làm mới.
devicebuddy.incomplete=Quá trình quét không thể hoàn tất cho tất cả các nguồn. Hãy thử Làm mới; điều này không có nghĩa là không tìm thấy thiết bị nào.
devicebuddy.empty=Không tìm thấy thiết bị đang kết nối nào thiếu thông tin pin trong các loại thiết bị ngoại vi được hỗ trợ. Windows có thể không hiển thị từng thiết bị riêng biệt.
devicebuddy.controller=Bộ điều khiển {0}
devicebuddy.noReading=Không có thông tin pin nào khả dụng
devicebuddy.reportedWired=Windows báo cáo không có pin
devicebuddy.readFailed=Truy vấn pin thất bại
devicebuddy.connection.Unknown=Không xác định
devicebuddy.connection.Usb=USB
devicebuddy.connection.UsbReceiver=Bộ thu USB (dongle)
devicebuddy.connection.Bluetooth=Bluetooth
devicebuddy.connection.XInput=Bộ điều khiển XInput; không xác định được kết nối
devicebuddy.connection.XInputWired=Windows báo cáo có dây (XInput)
devicebuddy.connection.UsbXInputWired=USB; Windows báo cáo có dây (XInput)
devicebuddy.reason.NoBluetoothReading=Thiết bị được kết nối hiện không cung cấp thông tin pin thông qua trình điều khiển Bluetooth của Windows. Một chế độ kết nối khác có thể cung cấp, chẳng hạn như bộ thu USB (dongle) hoặc cáp USB trực tiếp, nếu được hỗ trợ. Không đảm bảo rằng một chế độ khác sẽ giúp ích.
devicebuddy.reason.NoUsbReading=Windows phát hiện thiết bị này qua USB, nhưng BatteryBuddy chưa tìm thấy thông tin pin có thể sử dụng được. Một bộ thu phát không dây (USB dongle) cũng có thể xuất hiện dưới dạng thiết bị USB. Hãy thử Bluetooth hoặc chế độ kết nối khác, nếu được hỗ trợ, và kiểm tra hướng dẫn của nhà sản xuất. Thiết bị thực sự không có pin thì không cần giám sát pin.
devicebuddy.reason.ReceiverInterface=Windows phát hiện bộ thu USB (dongle) với loại giao diện thiết bị này, nhưng BatteryBuddy không có thông tin pin phù hợp. Bộ thu có thể hiển thị một giao diện ngay cả khi không có thiết bị tương ứng được gắn vào. Hãy kiểm tra xem thiết bị của bạn có đang hoạt động và được ghép nối với bộ thu này không, hoặc thử Bluetooth nếu được hỗ trợ. Windows có thể không nhận diện các thiết bị đằng sau bộ thu một cách riêng biệt.
devicebuddy.reason.ReportedWired=Một bộ thu phát không dây (USB dongle) có thể tự trình bày với Windows như một bộ điều khiển có dây, như thể nó được cắm trực tiếp bằng cáp USB. Windows báo cáo bộ điều khiển này là có dây và không cung cấp thông tin pin hợp lệ qua XInput, vì vậy BatteryBuddy không thể đọc pin của nó theo cách này. Bạn có thể thử Bluetooth, nếu được hỗ trợ, để xem liệu thông tin pin có khả dụng hay không.
devicebuddy.reason.UnknownXInputBattery=Windows phát hiện bộ điều khiển này, nhưng giao diện XInput của nó không cung cấp thông tin pin hợp lệ. Hãy thử chế độ kết nối được hỗ trợ khác, hoặc kiểm tra hướng dẫn về trình điều khiển và firmware của nhà sản xuất. Loại kết nối không phải lúc nào cũng có thể xác định chỉ từ XInput.
devicebuddy.reason.BatteryQueryFailed=Windows phát hiện thiết bị này, nhưng việc truy vấn pin đã thất bại. Điều này không có nghĩa là thiết bị không có pin. Hãy thử Làm mới khi thiết bị đang hoạt động, kết nối lại nó, hoặc thử chế độ kết nối được hỗ trợ khác.

devicelist.intro=Danh sách này hiển thị các nhóm giao thức được hỗ trợ, không phải từng mẫu đã được kiểm chứng. Các thiết bị tương thích khác cũng có thể hoạt động.
devicelist.connection=Kết nối
devicelist.verified=Đã kiểm chứng trên phần cứng
devicelist.unverified=Chưa kiểm chứng từng mẫu
devicelist.comments=Ghi chú / hạn chế
devicelist.comment.logitech=Nếu thiết bị ngừng phản hồi (ví dụ: ngủ hoặc ngắt kết nối trong khi bộ thu vẫn được cắm), lần đọc cuối cùng sẽ được giữ trong tối đa ba giờ.
devicelist.comment.nova7=Thử nghiệm; vui lòng gửi phản hồi. Bộ thu được kết nối có thể giữ mức pin cuối cùng sau khi tai nghe ngắt kết nối.
devicelist.comment.experimental=Thử nghiệm; vui lòng gửi phản hồi. Chưa được kiểm tra trên phần cứng BatteryBuddy.
devicelist.comment.coarse=Thử nghiệm; vui lòng gửi phản hồi. Phần trăm pin là ước tính; chưa được kiểm tra trên phần cứng BatteryBuddy.
devicelist.comment.percentonly=Thử nghiệm; chưa được kiểm tra phần cứng trong BatteryBuddy. Trạng thái sạc không khả dụng.
devicelist.comment.receiverbuffer=Thử nghiệm; chưa được kiểm tra phần cứng trong BatteryBuddy. Các giá trị được đệm bởi bộ thu nhận có thể bị trễ hoặc vẫn cũ trong khi chuột không di chuyển; chúng không chứng minh kết nối chuột. Trạng thái sạc có thể không khả dụng.
devicelist.comment.linkunknown=Thử nghiệm; chưa được kiểm tra phần cứng trong BatteryBuddy. Trạng thái sạc và phát hiện ngắt kết nối phía bộ thu nhận không khả dụng.
devicelist.comment.maxwell=Thử nghiệm; chưa được kiểm tra phần cứng trong BatteryBuddy. Một bộ thu nhận được kết nối có thể giữ mức pin cuối cùng sau khi tai nghe ngắt kết nối. Trạng thái sạc không khả dụng.
devicelist.comment.mixed=Thử nghiệm; chưa được kiểm tra phần cứng trong BatteryBuddy. Một số mẫu báo cáo mức pin gần đúng hoặc không có trạng thái sạc.
devicelist.comment.logitechvoltage=Một số mẫu ước tính phần trăm pin từ điện áp. Nếu thiết bị ngừng phản hồi (ví dụ: ngủ hoặc ngắt kết nối trong khi bộ thu nhận của nó vẫn được kết nối), lần đọc cuối cùng của nó được giữ trong tối đa ba giờ.
