<Window x:Class="BatteryBuddy.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:BatteryBuddy.App.Views"
        Width="780" Height="800" MinWidth="600" MinHeight="560"
        Background="{DynamicResource BB.Window}" Foreground="{DynamicResource BB.Text}"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,10,0,2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="Tabs" Grid.Row="0">
            <!-- Tab 1: aktuelle Geräte und deren Einstellungen -->
            <TabItem x:Name="DevicesTab">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="120"/>
                        <RowDefinition Height="1.6*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                        <Button x:Name="RefreshButton" DockPanel.Dock="Right" Padding="14,4" Click="OnRefresh"/>
                        <TextBlock x:Name="UpdatedText" VerticalAlignment="Center" Foreground="{DynamicResource BB.Muted}"/>
                    </DockPanel>
                    <TextBlock x:Name="FailedText" Grid.Row="1" Foreground="{DynamicResource BB.Error}" TextWrapping="Wrap" Margin="0,0,0,6" Visibility="Collapsed"/>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- Spaltenüberschriften: Breiten passen zu den Spalten der Zeilenvorlage unten. -->
                        <Grid Grid.Row="0" Margin="10,0,10,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="64"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ColName" Grid.ColumnSpan="2" FontWeight="SemiBold" Foreground="{DynamicResource BB.Muted}"/>
                            <TextBlock x:Name="ColCharge" Grid.Column="2" FontWeight="SemiBold" Foreground="{DynamicResource BB.Muted}" Margin="6,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="ColContact" Grid.Column="3" Grid.ColumnSpan="2" FontWeight="SemiBold" Foreground="{DynamicResource BB.Muted}" TextAlignment="Right" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                        <Grid Grid.Row="1">
                        <ListView x:Name="DeviceList" SelectionMode="Single" SelectionChanged="OnDeviceSelected"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Margin="2,10,0,2"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListView.GroupStyle>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Summary}"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,3" Opacity="{Binding Opacity}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="64"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid VerticalAlignment="Center" HorizontalAlignment="Left" Width="24" Height="24">
                                            <Image Source="{Binding CategoryImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="20" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CategoryImage}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <ProgressBar Grid.Column="2" Minimum="0" Maximum="100" Height="12" Value="{Binding Percent, Mode=OneWay}" IsHitTestVisible="False"
                                                     Foreground="{Binding Brush}" Margin="6,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding LevelText}" FontWeight="SemiBold" Foreground="{Binding Brush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{Binding ContactText}" ToolTip="{Binding ContactTip}" Foreground="{DynamicResource BB.Muted}"
                                                   VerticalAlignment="Center" TextAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel x:Name="StatePanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Margin="24">
                            <Image x:Name="StateImage" Width="120" Height="120" Stretch="Uniform" HorizontalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name=""/>
                            <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"
                                       Foreground="{DynamicResource BB.Text}"/>
                            <TextBlock x:Name="EmptyHint" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Foreground="{DynamicResource BB.Muted}"/>
                        </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- Einstellungen des ausgewählten Geräts -->
                    <Border Grid.Row="3" x:Name="DetailPanel" BorderBrush="{DynamicResource BB.Border}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,8,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock x:Name="DetailTitle" FontWeight="Bold" FontSize="14"/>
                                <CheckBox x:Name="DevIgnore" Click="OnDeviceChanged"/>
                                <StackPanel x:Name="DevOptions">
                                    <DockPanel Margin="0,4,0,8">
                                        <TextBlock x:Name="DevCategoryLabel" Width="192" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="DevCategory" SelectionChanged="OnDeviceChanged" HorizontalAlignment="Left" MinWidth="200"/>
                                    </DockPanel>
                                    <v:AlertPanel x:Name="DevAlerts"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <TextBlock x:Name="SelectHint" Grid.Row="3" Foreground="{DynamicResource BB.Muted}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </Grid>
            </TabItem>

            <!-- Tab 2: allgemeine Einstellungen -->
            <TabItem x:Name="SettingsTab">
                <ScrollViewer x:Name="SettingsScrollViewer" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock x:Name="GeneralHeader" FontWeight="Bold" FontSize="14"/>
                        <CheckBox x:Name="Autostart" Margin="0,8,0,0" Click="OnGeneralChanged"/>
                        <CheckBox x:Name="StartMenu" Click="OnGeneralChanged"/>

                        <TextBlock x:Name="TrayBehaviorLabel" Style="{StaticResource Label}"/>
                        <WrapPanel x:Name="TrayBehaviorOptions">
                            <WrapPanel.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{DynamicResource BB.Border}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="CornerRadius" Value="4"/>
                                    <Setter Property="Padding" Value="8,5"/>
                                    <Setter Property="Margin" Value="0,0,8,6"/>
                                </Style>
                            </WrapPanel.Resources>
                            <Border>
                                <CheckBox x:Name="TrayByCategory" Checked="OnTrayModeChanged" Unchecked="OnTrayModeChanged">
                                    <TextBlock x:Name="TrayByCategoryText" TextWrapping="Wrap" MaxWidth="260"/>
                                </CheckBox>
                            </Border>
                            <Border>
                                <CheckBox x:Name="TrayByDevice" Checked="OnTrayModeChanged" Unchecked="OnTrayModeChanged">
                                    <TextBlock x:Name="TrayByDeviceText" TextWrapping="Wrap" MaxWidth="260"/>
                                </CheckBox>
                            </Border>
                        </WrapPanel>
                        <TextBlock Margin="0,0,0,4" TextWrapping="Wrap" Foreground="{DynamicResource BB.Muted}">
                            <Run x:Name="TrayThresholdHint"/>
                            <InlineUIContainer BaselineAlignment="Center">
                                <CheckBox x:Name="TrayAlwaysShow" Margin="4,0,0,0"
                                          Checked="OnGeneralChanged" Unchecked="OnGeneralChanged"/>
                            </InlineUIContainer>
                        </TextBlock>

                        <TextBlock x:Name="IntervalLabel" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="Interval" HorizontalAlignment="Left" MinWidth="120" SelectionChanged="OnGeneralChanged"/>

                        <TextBlock x:Name="ActiveLabel" Style="{StaticResource Label}"/>
                        <DockPanel Margin="0,0,0,2">
                            <TextBlock x:Name="ActiveValue" DockPanel.Dock="Right" Width="64" TextAlignment="Right" VerticalAlignment="Center"/>
                            <Slider x:Name="ActiveSlider" Minimum="5" Maximum="480" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="OnActiveChanged"/>
                        </DockPanel>
                        <TextBlock x:Name="ActiveHint" Foreground="{DynamicResource BB.Muted}" TextWrapping="Wrap"/>

                        <TextBlock x:Name="LanguageLabel" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="LanguageBox" HorizontalAlignment="Left" MinWidth="240" SelectionChanged="OnGeneralChanged"/>

                        <TextBlock x:Name="ThemeLabel" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="ThemeBox" HorizontalAlignment="Left" MinWidth="240" SelectionChanged="OnGeneralChanged"/>

                        <TextBlock x:Name="DefaultsHeader" FontWeight="Bold" FontSize="14" Margin="0,24,0,0"/>
                        <v:AlertPanel x:Name="DefAlerts"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="ProVersionTab">
                <v:ProVersionTabView x:Name="ProVersionContent"/>
            </TabItem>

            <TabItem x:Name="LicenseTab">
                <v:LicenseTabView x:Name="LicenseContent"/>
            </TabItem>

            <!-- Tab 5: Beiträge Dritter (Quellen und Lizenzen) -->
            <TabItem x:Name="ContribTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock x:Name="ContribHeader" FontWeight="Bold" FontSize="14"/>
                        <TextBlock x:Name="ContribIntro" Foreground="{DynamicResource BB.Muted}" TextWrapping="Wrap" Margin="0,4,0,10"/>
                        <Grid x:Name="ContribGrid"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="1" Margin="0,10,0,0">
            <Button x:Name="CloseButton" DockPanel.Dock="Right" Padding="18,5" Margin="8,0,0,0" IsCancel="True" Click="OnClose"/>
            <Button x:Name="SaveButton" DockPanel.Dock="Right" Padding="18,5" IsDefault="True" Click="OnSave"/>
            <Border x:Name="VersionInfo" DockPanel.Dock="Left" Height="{Binding ActualHeight, ElementName=SaveButton}"
                    BorderBrush="{DynamicResource BB.Border}" BorderThickness="1" CornerRadius="4"
                    Padding="6,2" Margin="0,0,6,0" Background="Transparent">
                <TextBlock x:Name="VersionText" VerticalAlignment="Center" Foreground="{DynamicResource BB.Muted}"/>
            </Border>
            <Grid HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BugReportButton" Grid.Column="1" Height="{Binding ActualHeight, ElementName=SaveButton}"
                        Background="Transparent"
                        Padding="6,2" Margin="0,0,6,0" Click="OnBugReport">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image x:Name="BugReportIcon" Width="18" Height="18" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock x:Name="BugReportText" Margin="4,0,0,0" FontSize="11" VerticalAlignment="Center"
                                   MaxWidth="120" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Button>
                <!-- Keine zusaetzliche Fusszeilenhoehe: Bilder maximal 40 DIP, sonst passend zu den Buttons. -->
                <v:OriginStrip x:Name="OriginInfo" Height="{Binding ActualHeight, ElementName=SaveButton}"
                               MaxHeight="40" Margin="0,0,8,0">
                    <v:OriginStrip.Style>
                        <Style TargetType="v:OriginStrip">
                            <!-- Speicherfehler und Simulationsstatus haben Vorrang vor dem Infobereich. -->
                            <Setter Property="Visibility" Value="Hidden"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=StatusText}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </v:OriginStrip.Style>
                </v:OriginStrip>
                <TextBlock x:Name="StatusText" Text="" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <!-- Ein leeres Statusfeld darf weder Hover abfangen noch einen leeren Tooltip zeigen. -->
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
