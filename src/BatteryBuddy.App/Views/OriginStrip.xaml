<UserControl x:Class="BatteryBuddy.App.Views.OriginStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <UserControl.Resources>
        <Style TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource BB.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style TargetType="Image">
            <Setter Property="Width" Value="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=DockPanel}}"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Margin="0,0,6,0">
            <DockPanel x:Name="IdeaItem">
                <Image x:Name="IdeaImage" DockPanel.Dock="Left"/>
                <TextBlock x:Name="IdeaText" MaxWidth="60"/>
            </DockPanel>
        </Border>
        <Border Grid.Column="1" Margin="0,0,6,0">
            <DockPanel x:Name="DevelopmentItem">
                <Image x:Name="DevelopmentImage" DockPanel.Dock="Left"/>
                <TextBlock x:Name="DevelopmentText" MaxWidth="90"/>
            </DockPanel>
        </Border>
        <Border Grid.Column="2" HorizontalAlignment="Left">
            <DockPanel x:Name="TeamworkItem">
                <Image x:Name="TeamworkImage" DockPanel.Dock="Left"/>
                <TextBlock x:Name="TeamworkText"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
