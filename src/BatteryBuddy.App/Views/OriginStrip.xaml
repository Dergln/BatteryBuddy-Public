<UserControl x:Class="BatteryBuddy.App.Views.OriginStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False" KeyboardNavigation.TabNavigation="Local">
    <UserControl.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/BatteryBuddy;component/Themes/Controls.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <Style TargetType="Button" BasedOn="{StaticResource BB.Button}">
            <Setter Property="BorderBrush" Value="{DynamicResource BB.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,2"/>
        </Style>
        <Style TargetType="Image">
            <Setter Property="Width" Value="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=DockPanel}}"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
      </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Button Margin="0,0,6,0">
            <DockPanel x:Name="IdeaItem">
                <Image x:Name="IdeaImage" DockPanel.Dock="Left"/>
                <TextBlock x:Name="IdeaText" MaxWidth="60"/>
            </DockPanel>
        </Button>
        <Button Grid.Column="1" Margin="0,0,6,0">
            <DockPanel x:Name="DevelopmentItem">
                <Image x:Name="DevelopmentImage" DockPanel.Dock="Left"/>
                <TextBlock x:Name="DevelopmentText" MaxWidth="90"/>
            </DockPanel>
        </Button>
        <Button Grid.Column="2" HorizontalAlignment="Left">
            <DockPanel x:Name="TeamworkItem">
                <Image x:Name="TeamworkImage" DockPanel.Dock="Left"/>
                <TextBlock x:Name="TeamworkText"/>
            </DockPanel>
        </Button>
    </Grid>
</UserControl>
